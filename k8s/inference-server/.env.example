# vLLM Inference Server Environment Configuration
# Copy to .env and update values for your deployment

# ============================================================================
# Model Configuration
# ============================================================================

# HuggingFace model ID (gated models require HF_TOKEN)
MODEL_NAME=meta-llama/Llama-2-70b-hf

# Model data type: float16, float32, bfloat16
DTYPE=float16

# Allow loading custom code from model repo
TRUST_REMOTE_CODE=true

# ============================================================================
# GPU Memory Optimization (PagedAttention)
# ============================================================================

# Percentage of GPU VRAM to allocate for KV cache (0.0-1.0)
# Higher = more tokens per request, but less headroom
GPU_MEMORY_UTILIZATION=0.95

# Token block size for KV cache (16 is default, good for most models)
BLOCK_SIZE=16

# CPU swap space for overflow KV cache (bytes)
# Example: 4GB = 4000000000 bytes
SWAP_SPACE_BYTES=4000000000

# ============================================================================
# Continuous Batching Configuration
# ============================================================================

# Maximum number of parallel requests
# Higher = more throughput, but higher latency
MAX_NUM_SEQS=256

# Maximum tokens to batch together
# Higher = better GPU utilization, but more memory
MAX_TOKENS_BATCHED=8192

# Maximum sequence length (tokens in context + generation)
MAX_MODEL_LEN=4096

# ============================================================================
# Quantization
# ============================================================================

# Quantization method: awq, gptq, or empty string for none
# AWQ: Activation-aware Weight Quantization (recommended)
# GPTQ: Group Quantization
QUANTIZATION=awq

# Load format: auto, safetensors, pt, pickle
LOAD_FORMAT=auto

# ============================================================================
# Request Handling
# ============================================================================

# Maximum pending requests in queue
MAX_WAITING_REQUESTS=1000

# Distributed serving with tensor parallelism (1 = single GPU)
TENSOR_PARALLEL_SIZE=1

# ============================================================================
# Kubernetes & Container
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# vLLM attention backend
VLLM_ATTENTION_BACKEND=paged_attention

# Disable parallel tokenizer (avoid deadlocks)
TOKENIZERS_PARALLELISM=false

# Unbuffered Python output
PYTHONUNBUFFERED=1

# CUDA devices to use
CUDA_VISIBLE_DEVICES=0

# NVIDIA driver capabilities
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================================
# API Configuration
# ============================================================================

# API host and port (for Docker/K8s, use 0.0.0.0:8000)
API_HOST=0.0.0.0
API_PORT=8000

# Metrics port (Prometheus)
METRICS_PORT=8265

# Optional API key for authentication
# If set, clients must include: Authorization: Bearer <API_KEY>
# API_KEY=your-secret-key-here

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Prometheus scrape interval (seconds)
PROMETHEUS_INTERVAL=30

# Log inference requests to stdout (true/false)
LOG_REQUESTS=true

# Log query latency (true/false)
LOG_LATENCY=true

# ============================================================================
# Performance Tuning
# ============================================================================

# Enable prefix caching (KV cache reuse for common prompts)
ENABLE_PREFIX_CACHING=true

# Preemption mode: recompute (fair) or swap (faster)
PREEMPTION_MODE=recompute

# Maximum concurrent workers (for vLLM AsyncLLMEngine)
WORKER_THREADS=4

# ============================================================================
# HuggingFace & Model Access
# ============================================================================

# HuggingFace API token (for gated models like Llama 2)
# Get from: https://huggingface.co/settings/tokens
# HF_TOKEN=your-hf-token-here

# HuggingFace home directory (cache location)
HF_HOME=/home/vllm/.cache

# ============================================================================
# Cloud Storage (for model caching)
# ============================================================================

# GCS bucket for model weights (if using Google Cloud Storage)
# MODEL_CACHE_GCS_BUCKET=your-bucket-name

# AWS S3 bucket for model weights (if using S3)
# MODEL_CACHE_S3_BUCKET=your-bucket-name
# AWS_REGION=us-west-2

# ============================================================================
# Advanced Options (Optional)
# ============================================================================

# Batch size for encoder models
# ENCODER_BATCH_SIZE=32

# Max number of requests per minute per IP
# RATE_LIMIT_PER_IP=1000

# Request timeout in seconds
REQUEST_TIMEOUT=60

# GPU temperature threshold (Celsius) - thermal throttling at 85°C
MAX_GPU_TEMP=85

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Custom OpenAI API compatibility mode
OPENAI_API_COMPATIBLE=true
