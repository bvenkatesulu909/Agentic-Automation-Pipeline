# Virtualenv
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Secrets / local config
.env

# Built index (regenerate with `ragstack index`)
.ragstack_index/

# TECOMA sales desk database (recreated on first run, with the demo book)
tecoma_sales/tecoma.db*

# Feedback desk database (recreated on first run, with the demo inbox)
feedback_desk/feedback.db*

# Test / tooling caches
.pytest_cache/

# ADK dev-UI session and artifact storage (recreated on each `adk web` run)
adk_apps/**/.adk/

# ADK dev-UI scaffold exports (a stub root_agent.yaml that contradicts agent.py)
adk_apps/**/tmp/

# Nested git repositories — these are their own repos, not content of this one.
# Without these lines a `git add .` here would store them as bare gitlinks
# instead of files.
sap-abap-pr-approval/
abapGit/
abapGit-build/
Multi-Orchestration-agents/
drying-plant-erp/

# Reference PDFs kept locally. Large binaries, and not source for this repo.
*.pdf

# CI/CD Secrets (DO NOT COMMIT)
.secrets
.env.secrets
k8s/overlays/*/secrets.env
k8s/overlays/*/.secrets

# GitHub Actions
.act

# ArgoCD
.argocd

# Kustomize build output
k8s/**/kustomization.yaml.bak

# Generated files
artifacts/
*.tar.gz
*.tar

# IDE specific
.idea/
.vscode/settings.json
*.swp
*.swo
*~

# Coverage
.coverage
htmlcov/

# Docker build cache
.docker/
docker-compose.override.yml
