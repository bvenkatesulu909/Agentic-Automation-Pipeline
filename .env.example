# Copy to `.env` and edit. Real environment variables win over anything here.
# `.env` is gitignored; this file is not — never put a live key in it.

# --- Credential --------------------------------------------------------------
# Only needed for the `anthropic` backend. Get one at:
#   https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# --- Who answers -------------------------------------------------------------
# anthropic  Claude over the API. Needs ANTHROPIC_API_KEY.
# ollama     A local model. No key, no network past localhost, but slower.
RAGSTACK_LLM_BACKEND=ollama

# --- Local generation (Ollama) -----------------------------------------------
# The KV cache is allocated for the whole window at load time, so this is a RAM
# setting as much as a length one. llama3.2's full 131072-token window wants
# ~14GB and fails to allocate on an 8GB host; 4096 holds a 5-passage prompt.
RAGSTACK_OLLAMA_NUM_CTX=4096
# RAGSTACK_OLLAMA_MODEL=llama3.2:3b
# RAGSTACK_OLLAMA_HOST=http://127.0.0.1:11434
# RAGSTACK_OLLAMA_MAX_TOKENS=1024
# RAGSTACK_OLLAMA_TIMEOUT=600

# --- Cloud generation (Anthropic) --------------------------------------------
# RAGSTACK_ANSWER_MODEL=claude-opus-5
# RAGSTACK_ANSWER_EFFORT=medium          # low|medium|high|xhigh|max
# RAGSTACK_ANSWER_MAX_TOKENS=8000

# --- Corpus, chunking, retrieval ---------------------------------------------
# RAGSTACK_DOCS_DIR=./docs
# RAGSTACK_INDEX_DIR=./.ragstack_index
# RAGSTACK_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAGSTACK_CHUNK_SIZE=1200
# RAGSTACK_CHUNK_OVERLAP=200
# RAGSTACK_TOP_K=5
# RAGSTACK_MIN_SCORE=0.15

# --- Venki News (venki_news/) ------------------------------------------------
# The app runs with none of these set: the wire layer polls nineteen public RSS
# feeds without a key, and the ten-agent editorial pass switches itself off.
#
# Turn the newsroom on by supplying a key. VENKI_EDITORIAL=auto (the default)
# enables it when a key is present; `on` fails at startup if one is missing;
# `off` keeps the agents off even with a key.
# OPENAI_API_KEY=sk-...
# VENKI_EDITORIAL=auto                   # auto|on|off
# VENKI_MODEL=gpt-5.4-mini

# To route through OpenRouter instead — same SDK, Chat Completions rather than
# the Responses API, tracing disabled because traces upload to OpenAI. The
# OpenRouter default is tencent/hy3; VENKI_MODEL overrides it with any model
# whose supported_parameters carry BOTH `tools` and `structured_outputs`.
# VENKI_MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# VENKI_MODEL=tencent/hy3
#
# OpenRouter fans one model id out across upstream providers with different
# feature sets — hy3 comes with structured outputs from DeepInfra, Novita,
# AtlasCloud and Baidu, without them from Tencent's own endpoint, and without
# tools at all from GMICloud. The app always sends provider.require_parameters,
# so a thin endpoint is skipped rather than silently breaking a pass. Set this
# only to narrow further; comma-separated, in preference order.
# VENKI_OPENROUTER_PROVIDERS=deepinfra,novita

# Cadence. These two are separate on purpose: the wire tick is free and runs
# every minute, the editorial pass costs 8-12 model calls and runs only when
# the wire brought something new. See venki_news/config.py.
# VENKI_WIRE_INTERVAL=60                 # seconds between feed polls
# VENKI_EDITORIAL_MIN_INTERVAL=180       # floor between editorial passes
# VENKI_EDITORIAL_MAX_INCIDENTS=6        # clusters per pass

# VENKI_HOST=127.0.0.1
# VENKI_PORT=8300
# VENKI_TICKER_MAX_CHARS=90
# VENKI_FRONT_PAGE_SIZE=24
# VENKI_MAX_ITEM_AGE_MINUTES=360
