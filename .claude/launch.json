{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adk-incident-commander",
      "runtimeExecutable": ".venv/Scripts/adk.exe",
      "runtimeArgs": ["web", "adk_apps", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8123", "--directory", "dashboard"],
      "port": 8123
    },
    {
      "name": "venki-news",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "venki_news"],
      "port": 8300
    },
    {
      "name": "dryerp-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "dryerp.api.main:app",
        "--host", "127.0.0.1", "--port", "8400",
        "--app-dir", "drying-plant-erp/src"
      ],
      "port": 8400
    },
    {
      "name": "tecoma-sales",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tecoma_sales", "--port", "8800"],
      "port": 8800
    },
    {
      "name": "tecoma-server",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "tecoma_sales.server:app",
        "--host", "127.0.0.1", "--port", "8820",
        "--app-dir", "C:/Users/User/Desktop/tecoma"
      ],
      "port": 8820
    },
    {
      "name": "feedback-desk",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "feedback_desk", "--port", "8900"],
      "port": 8900
    },
    {
      "name": "tecoma-static",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "http.server", "8810",
        "--directory", "C:/Users/User/Desktop/tecoma/web"
      ],
      "port": 8810
    },
    {
      "name": "customer-seeding",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app.py"],
      "port": 5000
    },
    {
      "name": "copilot-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "copilot-streaming-ui"],
      "port": 3000
    }
  ]
}
